# Copy to .env for local use. Never use VITE_ for owner identity or secrets.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=
# Dedicated vault encryption secret. If unset, BETTER_AUTH_SECRET is used.
# The app fails closed when both are empty. Do not reuse XAI_API_KEY here.
TALKAI_VAULT_KEY=
PROVIDER_CREDENTIAL_SECRET=
# Email of the account allowed to manage shared AI/transcription settings.
TALKAI_ADMIN_EMAIL=owner@example.com
TALKAI_ADMIN_NAME=Administrator
# Optional local bootstrap; leave unset to register/sign in normally.
TALKAI_ADMIN_PASSWORD=
# Optional Postgres; unset uses embedded PGlite.
DATABASE_URL=
# Optional persistent local PGlite directory; unset uses memory.
TALKAI_DATA_DIR=
# Federation is optional. Supply your own broker credentials for Google/X.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
# Optional AI provider keys; configured in server environment or owner Settings.
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional local transcription setup; see docs/providers-and-models.md.
TALKAI_LOCAL_MODE=0
TALKAI_WHISPERKIT_CLI=
TALKAI_WHISPERKIT_MODEL_DIR=
TALKAI_FFMPEG_PATH=

# Optional OpenRouter attribution origin; use a URL you control.
OPENROUTER_SITE_URL=
